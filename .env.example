# Server
NODE_ENV=development
PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/nexaops_dev
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
CLIENT_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Seed demo accounts (dev only)
SEED_ADMIN_EMAIL=admin@nexaops.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_MANAGER_EMAIL=manager@nexaops.local
SEED_MANAGER_PASSWORD=Manager123!
SEED_EMPLOYEE_EMAIL=employee@nexaops.local
SEED_EMPLOYEE_PASSWORD=Employee123!
